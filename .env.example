# Database PostgreSQL (Neon ou Supabase)
# DATABASE_URL : connexion poolée (utilisée par l'application à l'exécution)
# DIRECT_URL   : connexion directe, non poolée (utilisée par Prisma Migrate)
# Avec Neon, DIRECT_URL correspond à l'hôte SANS le suffixe "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler:5432/manoir?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/manoir?sslmode=require"

# Stripe — créer les clés dans le tableau de bord Stripe
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Administration — générer un mot de passe robuste et un secret aléatoire
ADMIN_EMAIL="admin@manoirdetireveste.com"
ADMIN_PASSWORD_HASH="$2b$12$REMPLACER_PAR_UN_HASH_BCRYPT"
AUTH_SECRET="REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG"

# Emails transactionnels
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Manoir de Tireveste <reservations@manoirdetireveste.com>"
BOOKING_NOTIFICATION_EMAIL="contact@manoirdetireveste.com"
